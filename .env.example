# =====================================================================
# SierraFlow - variables de entorno (copiar a .env y completar)
# =====================================================================
NODE_ENV=development
WEB_URL=http://localhost:3000

# --- PostgreSQL ---
# Usuario dueño del esquema (migraciones)
DATABASE_URL_OWNER=postgres://sierraflow_owner:CLAVE_OWNER@127.0.0.1:5432/sierraflow
# Usuario de la aplicación (mínimos privilegios)
DATABASE_URL=postgres://sierraflow_app:CLAVE_APP@127.0.0.1:5432/sierraflow
# Servicio de analítica (rol sierraflow_analitica)
DATABASE_URL_ANALITICA=postgres://sierraflow_analitica:CLAVE_ANALITICA@127.0.0.1:5432/sierraflow
# Correos que reciben rol ADMIN/DIRECTOR/LIDER en su primer inicio de sesión
ADMIN_EMAILS=

# --- Web (Next.js / Auth.js) ---
# true = la web funciona sin IdP ni API (usuario demo + datos locales en IndexedDB)
NEXT_PUBLIC_MODO_DEMO=true
AUTH_SECRET=generar_con_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
API_URL_INTERNA=http://127.0.0.1:4000/api
NEXT_PUBLIC_API_URL=/api

# --- API (NestJS) ---
API_PORT=4000
JWT_EMISOR=https://proyectos.sierrainnova.tech
JWT_AUDIENCIA=sierraflow-api
# Claves RS256 en una sola línea con \n (ver README: "Generar claves")
JWT_CLAVE_PRIVADA=
JWT_CLAVE_PUBLICA=
# Restringe el login Google a un dominio de correo (vacío = sin restricción)
DOMINIO_PERMITIDO=
# Departamento asignado a usuarios nuevos (código de la tabla departamentos)
DEPARTAMENTO_POR_DEFECTO=TI
RUTA_ADJUNTOS=./.adjuntos

# --- Servicio de analítica (Python) ---
ANALITICA_URL_INTERNA=http://127.0.0.1:8000
